<%= simple_form_for(@movement, html: { class: 'movement-form bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4'}) do |f| %>
  <% if movement.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(movement.errors.count, "erro") %> impediram que esta movimentação fosse salva:</h2>

      <ul class="mt-2 ml-4">
        <% movement.errors.each do |error| %>
          <li class="list-disc"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Movement Type Header -->
  <div class="movement-type-header" style="display: none;">
    <div class="movement-type-icon">
      <span class="icon-text"></span>
    </div>
    <span class="type-text"></span>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <%= f.input :wallet_id, 
        collection: Wallet.all, 
        label: "Carteira",
        prompt: "Selecione uma carteira",
        input_html: { class: "form-control" } %>
    
    <!-- Enhanced User Selection -->
    <div class="user-search-container">
      <%= f.input :user_id, as: :hidden %>
      <div class="form-group">
        <label for="user-search-input" class="block text-sm font-medium text-gray-700 mb-1">
          Membro <span class="text-gray-400">(opcional)</span>
        </label>
        <input 
          type="text" 
          id="user-search-input" 
          class="user-search-input form-control"
          placeholder="Digite o nome do membro..."
          value="<%= @movement.user&.full_name %>"
        />
      </div>
    </div>
    
    <%= f.input :kind_of, 
        collection: Movement.kind_ofs.keys.map { |key| [key.humanize, key] }, 
        include_blank: false,
        label: "Tipo de Movimentação",
        input_html: { class: "form-control" } %>
        
    <%= f.input :sub_kind_of, 
        collection: Movement.sub_kind_ofs.keys.map { |key| [key.humanize, key] }, 
        include_blank: false,
        label: "Categoria",
        input_html: { class: "form-control" } %>
        
    <!-- Enhanced Amount Input -->
    <div class="amount-input-container">
      <%= f.input :amount, 
          input_html: { 
            min: '0', 
            step: 'any',
            class: "form-control",
            value: (@movement.persisted? ? @movement.amount_for_display : nil)
          },
          label: "Valor" %>
    </div>
    
    <%= f.input :payment_date, label: "Data do Pagamento" %>
    <%= f.input :receipt, label: "Comprovante" %>
  </div>
  
  <div class="grid grid-cols-1 gap-4 mt-4">
    <%= f.input :description, label: "Descrição" %>
  </div>

  <div class="grid grid-cols-1 gap-4 mt-6">
    <%= f.submit "Salvar Movimentação", 
        class: "rounded-lg py-3 px-5 bg-blue-600 hover:bg-blue-700 text-white inline-block font-medium cursor-pointer transition-colors duration-200" %>
  </div>
<% end %>

<script>
  // Initialize form enhancements when page loads
  document.addEventListener('DOMContentLoaded', function() {
    
    // Update category change behavior to work with new user search
    const subKindOfSelect = document.getElementById('movement_sub_kind_of');
    const userSearchContainer = document.querySelector('.user-search-container');
    const userSearchInput = document.getElementById('user-search-input');
    const userIdField = document.getElementById('movement_user_id');
    const kindOfSelect = document.getElementById('movement_kind_of');
        
    if (subKindOfSelect && userSearchContainer) {
      function updateUserFieldVisibility() {
        const selectedCategory = subKindOfSelect.options[subKindOfSelect.selectedIndex];
        const categoryText = selectedCategory ? selectedCategory.text.trim() : '';
        const categoryValue = selectedCategory ? selectedCategory.value : '';
                
        // Show user field only for "dízimo" category
        if (categoryValue === 'dízimo') {
          userSearchContainer.style.display = 'block';
          // Force entrada for dízimo
          if (kindOfSelect.value !== 'entrada') {
            kindOfSelect.value = 'entrada';
            kindOfSelect.dispatchEvent(new Event('change'));
          }
        } else {
          userSearchContainer.style.display = 'none';
          if (userSearchInput) userSearchInput.value = '';
          if (userIdField) userIdField.value = '';
        }        
      }
      
      // Initial setup
      updateUserFieldVisibility();
      
      // Listen for category changes
      subKindOfSelect.addEventListener('change', function() {
        updateUserFieldVisibility();
      });
      
    } else {
      updateUserFieldVisibility();
      
      // Listen for wallet changes
      walletSelect.addEventListener('change', function() {
        updateUserFieldVisibility();
      }); 
    }
  });
</script>