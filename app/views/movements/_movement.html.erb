<% if action_name != "show" %>
  <tr class="border-b <%= movement.expense? ? 'bg-red-50' : 'bg-green-50' %>">
    <td id="<%= dom_id movement %>" class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
      <%= movement.sub_kind_of.humanize %>
    </td>
    <td class="text-sm font-medium px-6 py-4 whitespace-nowrap <%= movement.expense? ? 'text-red-600' : 'text-green-600' %>">
      <%= movement.expense? ? '-' : '+' %><%= number_to_currency(movement.amount_for_display) %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap">
      <%= l movement.payment_date, format: :simple %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap" title="<%= movement.user&.full_name %>">
      <%= movement.user&.full_name || '-' %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap">
      <%= movement.wallet.name %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap">
      <%= movement.wallet.kind_of %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap" title="<%= movement.description %>">
      <%= movement.description.truncate(20) %>
    </td>
    <td class="text-sm text-gray-900 font-light px-6 py-4 whitespace-nowrap">
      <% if movement.receipt.attached? %>
        <%= link_to 'Recibo', movement.receipt, target: '_blank', class: 'text-blue-600 hover:text-blue-800' %>
      <% end %>
    </td>
    <td class="grid grid-cols-2">
      <% if action_name != "show" %>
        <%= link_to "Exibir", movement, class: "text-center border border-indigo-500 bg-indigo-500 text-white rounded-md px-4 py-2 m-2 transition duration-500 ease select-none hover:bg-indigo-600 focus:outline-none focus:shadow-outline" %>
        <%= link_to 'Editar', edit_movement_path(movement), class: "text-center border border-teal-500 bg-teal-500 text-white rounded-md px-4 py-2 m-2 transition duration-500 ease select-none hover:bg-teal-600 focus:outline-none focus:shadow-outline" %>
      <% else %>
        <%= link_to 'Editar', edit_movement_path(movement), class: "text-center border border-teal-500 bg-teal-500 text-white rounded-md px-4 py-2 m-2 transition duration-500 ease select-none hover:bg-teal-600 focus:outline-none focus:shadow-outline" %>
        <%= link_to 'Remover', movement_path(movement), method: :delete, class: "text-center border border-red-500 bg-red-500 text-white rounded-md px-4 py-2 m-2 transition duration-500 ease select-none hover:bg-red-600 focus:outline-none focus:shadow-outline" %>
      <% end %>
    </td>
  </td>
</tr>
<% else %>
  <div id="<%= dom_id movement %>" class="<%= movement.expense? ? 'bg-red-50 border-l-4 border-red-400' : 'bg-green-50 border-l-4 border-green-400' %> shadow rounded-lg p-4 sm:p-6 xl:p-8">
    
    <!-- Movement Type Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center space-x-3">
        <div class="<%= movement.expense? ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %> rounded-full p-2">
          <% if movement.expense? %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          <% else %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
          <% end %>
        </div>
        <div>
          <h2 class="text-xl font-bold <%= movement.expense? ? 'text-red-800' : 'text-green-800' %>">
            <%= movement.expense? ? 'Saída' : 'Entrada' %>
          </h2>
          <p class="text-sm text-gray-600"><%= movement.sub_kind_of.humanize %></p>
        </div>
      </div>
      <div class="text-right">
        <div class="text-2xl font-bold <%= movement.expense? ? 'text-red-600' : 'text-green-600' %>">
          <%= movement.expense? ? '-' : '+' %><%= number_to_currency(movement.amount_for_display) %>
        </div>
        <div class="text-sm text-gray-500">
          <%= l movement.payment_date, format: :long %>
        </div>
      </div>
    </div>

    <div class="text-gray-700">
      <div class="grid md:grid-cols-2 gap-6 text-sm">
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="font-semibold text-gray-600">Tipo de transação:</span>
            <span class="<%= movement.expense? ? 'text-red-700' : 'text-green-700' %> font-medium">
              <%= "#{movement.kind_of.humanize} - #{movement.sub_kind_of.humanize}" %>
            </span>
          </div>
          
          <div class="flex justify-between">
            <span class="font-semibold text-gray-600">Valor:</span>
            <span class="<%= movement.expense? ? 'text-red-600' : 'text-green-600' %> font-bold">
              <%= movement.expense? ? '-' : '+' %><%= number_to_currency(movement.amount_for_display) %>
            </span>
          </div>
          
          <div class="flex justify-between">
            <span class="font-semibold text-gray-600">Data do pagamento:</span>
            <span><%= l movement.payment_date, format: :long %></span>
          </div>
          
          <% if movement.user.present? %>
            <div class="flex justify-between">
              <span class="font-semibold text-gray-600">
                <%= movement.dízimo? ? 'Dizimista:' : 'Membro:' %>
              </span>
              <span class="text-blue-600 font-medium"><%= movement.user.full_name %></span>
            </div>
          <% end %>
          
          <div class="flex justify-between">
            <span class="font-semibold text-gray-600">Conta:</span>
            <span><%= movement.wallet.name %></span>
          </div>
          
          <div class="flex justify-between">
            <span class="font-semibold text-gray-600">Tipo de conta:</span>
            <span><%= movement.wallet.kind_of %></span>
          </div>
        </div>
        
        <div class="space-y-3">
          <div>
            <span class="font-semibold text-gray-600 block mb-2">Descrição:</span>
            <p class="text-gray-800 bg-gray-50 p-3 rounded border"><%= movement.description %></p>
          </div>
          
          <% if movement.receipt.attached? %>
            <div>
              <span class="font-semibold text-gray-600 block mb-2">Comprovante:</span>
              <%= link_to movement.receipt, target: '_blank', class: 'block' do %>
                <%= image_tag(movement.receipt.variant(:thumb), class: 'p-1 bg-white border rounded max-w-sm shadow-lg hover:shadow-xl transition-shadow') %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="flex space-x-4 mt-6 pt-6 border-t border-gray-200">
        <%= link_to 'Editar Movimentação', edit_movement_path(movement), 
            class: "flex-1 text-center border border-teal-500 bg-teal-500 text-white rounded-md px-4 py-2 transition duration-500 ease select-none hover:bg-teal-600 focus:outline-none focus:shadow-outline" %>
        <%= link_to 'Remover Movimentação', movement_path(movement), method: :delete, 
            data: { confirm: 'Tem certeza que deseja remover esta movimentação?' },
            class: "flex-1 text-center border border-red-500 bg-red-500 text-white rounded-md px-4 py-2 transition duration-500 ease select-none hover:bg-red-600 focus:outline-none focus:shadow-outline" %>
      </div>
    </div>
  </div>
<% end %>